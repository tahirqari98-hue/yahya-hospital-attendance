<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="20dp"
    android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="Employee Dashboard" android:textSize="28sp" android:textStyle="bold"
    android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/applyLeave" android:text="Apply Leave"
    android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/applyShortLeave" android:text="Apply Short Leave"
    android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/adminRequests" android:text="Admin: Leave Requests"
    android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/refreshDashboard" android:text="Refresh Dashboard"
    android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:id="@+id/dashboardList" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>